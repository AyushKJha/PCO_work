# Browser-visible configuration only. Never place provider or database secrets here.
# Set this to an HTTPS reverse proxy/API origin in deployed environments.
VITE_API_BASE_URL=/api/v1

# Optional non-production demo bearer token issued by the backend when
# DEMO_AUTH_ENABLED=true. Do not use this in production.
VITE_DEMO_ACCESS_TOKEN=
VITE_DEMO_AUTH_ENABLED=false
